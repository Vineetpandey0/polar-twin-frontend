# ── Backend API ───────────────────────────────────────────────────────────────
# Deployed Railway backend URL (production)
# In development, code uses: process.env.NEXT_PUBLIC_API_URL || "https://polar-twin-backend.up.railway.app" || "http://localhost:8000"
NEXT_PUBLIC_API_URL=https://polar-twin-backend.up.railway.app

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Deployed Railway WebSocket endpoint
NEXT_PUBLIC_WS_URL=wss://polar-twin-backend.up.railway.app/ws/stations
