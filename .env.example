# ── Backend API ───────────────────────────────────────────────────────────────
# URL of your deployed backend (polar-twin-backend)
# For local dev: http://localhost:8000
# For production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=https://polar-twin-backend.up.railway.app/

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Same host as API but with ws/wss scheme
NEXT_PUBLIC_WS_URL=wss://polar-twin-backend.up.railway.app/
